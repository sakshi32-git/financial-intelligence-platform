# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_NAME=financial_intelligence_platform
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-long-random-string

# ──────────────────────────────────────────────
# ──────────────────────────────────────────────
# PostgreSQL (Neon Serverless)
# ──────────────────────────────────────────────
# To connect to Neon PostgreSQL, you need the connection string from your Neon dashboard:
# 1. Log in to https://console.neon.tech
# 2. Select your project and navigate to the 'Dashboard'.
# 3. Copy the connection string. Ensure you use the pooled connection for production.
# 
# Example Connection String:
# DATABASE_URL=postgresql://[user]:[password]@[endpoint-id].neon.tech/[dbname]?sslmode=require
POSTGRES_HOST=postgresql://neondb_owner:npg_JZieSxIH9N7k@ep-twilight-butterfly-athyt931-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=fp_user
POSTGRES_PASSWORD=npg_JZieSxIH9N7k
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ──────────────────────────────────────────────
# API Keys — Financial Data Providers
# ──────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
POLYGON_API_KEY=your-polygon-key
YAHOO_FINANCE_API_KEY=your-yahoo-finance-key
FRED_API_KEY=232ae277d58dbfae41b36980edbdaa52

# ──────────────────────────────────────────────
# ETL
# ──────────────────────────────────────────────
ETL_BATCH_SIZE=1000
ETL_MAX_RETRIES=3
ETL_RETRY_DELAY_SECONDS=5

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json              # json | text
LOG_DIR=logs

# ──────────────────────────────────────────────
# Machine Learning
# ──────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_PATH=models

# ──────────────────────────────────────────────
# Dashboard
# ──────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=False

# ──────────────────────────────────────────────
# Redis (optional caching)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
